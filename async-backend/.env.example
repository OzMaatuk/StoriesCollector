# --- Server ---------------------------------------------------------------
# Bind locally only; cloudflared connects to this from the same machine.
HOST=127.0.0.1
PORT=8000

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Access control ---------------------------------------------------------
# Comma-separated hostname(s) your Cloudflare tunnel routes to this service.
# Requests with any other Host header are rejected (400).
ALLOWED_HOSTS=enrichment.yourdomain.com

# Comma-separated browser origins allowed to call this API via CORS.
# Leave empty if only server-to-server calls hit this API (no browser).
ALLOWED_ORIGINS=

# Shared secret required as "Authorization: Bearer <secret>" on requests.
# Leave empty to disable auth (not recommended).
ASYNC_SECRET=change-me-to-a-long-random-string

# --- Database ---------------------------------------------------------------
# Postgres connection string used to update the generated_content table.
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# --- LLM backend (llama.cpp server) -----------------------------------------
# Base URL of the local llama.cpp server. /v1/chat/completions is appended
# automatically if not already present.
LLAMA_CPP_URL=http://127.0.0.1:8080

# API key for the llama.cpp server, if it requires one. Leave empty if not.
LLAMA_CPP_API_KEY=

# Cold-start retry behavior: how many times to retry on 502/503/504/524 or
# timeout/connection errors, and how long to wait between retries.
LLM_MAX_RETRIES=60
LLM_RETRY_DELAY_SECONDS=5
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_REPEAT_PENALTY=1.2

# Max time (seconds) to wait for a single LLM response. Default is 24h since
# generation can take hours on constrained hardware (Jetson Nano).
LLM_REQUEST_TIMEOUT_SECONDS=86400

# --- Request defaults ---------------------------------------------------------
# Used as fallback values in GenerateRequest when not provided in the payload.
PROVIDER_NAME=llama-cpp-local
MODEL_NAME=llama-3-8b-instruct

# --- Concurrency -------------------------------------------------------------
# Number of concurrent enrichment jobs processed. Keep at 1 on Jetson Nano
# to avoid overloading the LLM with parallel requests.
MAX_WORKERS=1