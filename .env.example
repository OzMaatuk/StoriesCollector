# ================================
# Application
# ================================
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ================================
# Database (PostgreSQL)
# ================================
# Choose one based on your setup:

# For local development with Docker Compose. Docker Compose reads this local,
# untracked file to configure both services; use unique values, not examples.
# POSTGRES_USER=stories_user
# POSTGRES_PASSWORD=replace-with-a-local-secret
# POSTGRES_DB=stories_collector
# DATABASE_URL="postgresql://stories_user:replace-with-a-local-secret@postgres:5432/stories_collector?schema=public"

# For local development with local PostgreSQL
# DATABASE_URL="postgresql://stories_user:stories_pass@localhost:5432/stories_collector?schema=public"

# For hosted database (replace with your actual connection string)
# DATABASE_URL="postgresql://username:password@host:5432/database?schema=public"

# ================================
# Rate Limiting (In-Memory)
# ================================
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=10
# Set to true only when x-forwarded-for/x-real-ip are overwritten by a trusted proxy.
# RATE_LIMIT_TRUST_PROXY_HEADERS=false

# ================================
# External OTP Service
# ================================
# URL of your external OTP service
# OTP_SERVICE_URL=http://localhost:3000
# OTP_SERVICE_API_KEY=YOUR_OTP_SERVICE_API_KEY

# ================================
# JWT Configuration
# ================================
# Generate a secure secret (at least 32 characters)
# Use: openssl rand -base64 32
# JWT_SECRET=your-super-secret-jwt-key-min-32-chars-replace-this

# ================================
# Testing Configuration (for .env.test)
# ================================
# Copy this section to .env.test for local testing

# Test Database
# DATABASE_URL="postgresql://test_user:test_pass@localhost:5432/test_db?schema=public"

# Test Rate Limiting (more permissive for tests)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=1000

# OTP E2E Testing
# RUN_OTP_E2E=true
# TEST_OTP_CODE=123456

# Test JWT Secret
# JWT_SECRET=test-jwt-secret-32chars-for-testing-only

# ================================
# LLM Story Enrichment
# ================================
# ENABLE_LLM_ENRICHMENT=true
# LLM_MODEL_NAME=default
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your-api-key
# LLM_MAX_TOKENS=512
# Max wait time for a single LLM request (ms). Default: 86400000 (24 hours).
# LLM_REQUEST_TIMEOUT_MS=86400000
# ENABLE_CHAT_PROXY=false
# CHAT_PROXY_ALLOWED_MODELS=dicta-il/DictaLM-3.0-24B-Thinking-W4A16
# CHAT_PROXY_MAX_TOKENS=512
# CHAT_PROXY_MAX_BODY_BYTES=20000
# LLM_DEBUG_LOGS=false
# Set in Netlify UI (Site settings > Environment variables) for production.

# Maximum total public enrichment generations per story.
# ENRICHMENT_MAX_RETRIES=5

# When using async python backend:
# LLM_ASYNC_METHOD=true
# Shared secret for authenticating requests between StoriesCollector and Python backend.
# Must match the same value in async_backend.env. If unset, auth is skipped.
# ASYNC_SECRET=your-shared-secret-here
